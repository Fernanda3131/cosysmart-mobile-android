<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos generales -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permisos de ubicación -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Cámara opcional -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CosySmart">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".register.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".register.SecurityPoliciesActivity"
            android:exported="false" />

        <activity android:name=".login.LoginActivity"
            android:exported="false" />

        <activity android:name=".admin.ActivityHomeAdmin" />
        <activity android:name=".home.ActivityHome" />
        <activity android:name=".admin.users.ActivityAdminUsers" />
        <activity android:name=".login.ActivityForgotPassword" />

        <activity android:name=".admin.AdminFinanceActivity"
            android:exported="false" />

        <activity android:name=".admin.products.AdminCatalogActivity"
            android:exported="false" />

        <activity android:name=".seller.management.ActivitySellerOrders" />
        <activity android:name=".seller.management.ActivitySellerProducts" />
        <activity android:name=".seller.management.ActivitySellerSales" />
        <activity android:name=".seller.profile.ActivitySellerProfile" />

        <activity android:name=".buyer.ActivityCart" />
        <activity android:name=".buyer.ActivityCatalog" />
        <activity android:name=".buyer.ActivityBuyerProfile" />

        <activity android:name=".payments.ActivityCheckout" />
        <activity android:name=".payments.ActivityPaymentConfirmation" />

        <activity android:name=".buyer.ActivityProductDetail" />
        <activity android:name=".seller.management.ActivitySellerCreateProduct" />

        <activity android:name=".seller.management.ActivitySellerEditProduct"
            android:exported="false" />

        <activity android:name=".seller.management.ActivitySellerOrderDetails" />
        <activity android:name=".admin.products.ActivityAdminEditProduct" />

        <activity android:name=".admin.users.ActivityAdminUserDetail"
            android:exported="false" />

        <activity android:name=".admin.users.ActivityAdminEditUser"
            android:exported="false" />

        <activity android:name=".login.ActivityVerifyCode"
            android:exported="false" />

        <activity android:name=".login.ActivityResetPassword"
            android:exported="false" />

        <activity android:name=".buyer.ActivityOrderHistory"/>
        <activity android:name=".buyer.ActivityOrderDetail"/>
        <!-- FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>

    </application>

</manifest>
