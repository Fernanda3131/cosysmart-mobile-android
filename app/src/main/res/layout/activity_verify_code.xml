<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFBF7"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvNombreApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CosySmart"
            android:textColor="#333333"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/imgVerificacion"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Imagen de recuperación de contraseña"
            android:scaleType="centerCrop"
            android:src="@drawable/salalogin"
            app:layout_constraintTop_toBottomOf="@id/tvNombreApp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTituloVerificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Verifica tu correo"
            android:textColor="#333333"
            android:textSize="27sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/imgVerificacion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvDescripcionVerificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Hemos enviado un código de seis dígitos a tu correo electrónico. Ingrésalo para continuar."
            android:textColor="#666666"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloVerificacion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="Código de verificación"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#C05C38"
            app:layout_constraintTop_toBottomOf="@id/tvDescripcionVerificacion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="6"
                android:singleLine="true"
                android:textAlignment="center"
                android:textSize="22sp"
                android:textColor="#000000"
                android:textColorHint="#7A6D63"
                android:letterSpacing="0.3" />


        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerificarCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#C05C38"
            android:text="Verificar código"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilCodigo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverRecuperacion"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Regresar"
            android:textColor="#C05C38"
            app:strokeColor="#C05C38"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnVerificarCodigo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
