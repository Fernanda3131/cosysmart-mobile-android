<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFBF7">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:menu="@menu/menu_admin"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:elevation="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigationView"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btnBackCatalog"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_search_input"
                    android:contentDescription="Volver"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#3D3028" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Moderación Global"
                    android:textColor="#3D3028"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Productos y Categorías"
                android:textColor="#3D3028"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:text="Supervisa el catálogo global y la estructura de categorías"
                android:textColor="#7A6D63"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:background="@drawable/bg_search_input"
                android:padding="3dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnTabAdminProducts"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Catálogo General"
                    android:textSize="11sp"
                    android:textColor="#3D3028"
                    android:textStyle="bold"
                    android:backgroundTint="#FFFFFF"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/btnTabAdminCategories"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Categorías"
                    android:textSize="11sp"
                    android:textColor="#7A6D63"
                    android:backgroundTint="@android:color/transparent"
                    android:elevation="0dp"
                    app:elevation="0dp"
                    android:stateListAnimator="@null"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>
            <EditText
                android:id="@+id/etSearchAdminProducts"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_input"
                android:hint="Buscar por producto o ID..."
                android:textColorHint="#A68A78"
                android:textColor="#3D3028"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="10dp"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvAdminProductCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="0 productos"
                android:textColor="#7A6D63"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminProductsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Cargando catálogo..."
                android:textColor="#7A6D63"
                android:textSize="14sp"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/layoutAdminProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
