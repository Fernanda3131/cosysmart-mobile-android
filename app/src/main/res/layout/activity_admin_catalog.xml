<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFBF7">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:menu="@menu/menu_admin"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:elevation="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigationView"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btnBackCatalog"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_search_input"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#3D3028"
                    android:layout_centerVertical="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Moderación Global"
                    android:textColor="#3D3028"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Productos y Categorías"
                android:textColor="#3D3028"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:text="Supervisa el catálogo global y estructura de categorías"
                android:textColor="#7A6D63"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:background="@drawable/bg_search_input"
                android:padding="3dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Catálogo General (680)"
                    android:textSize="11sp"
                    android:textColor="#3D3028"
                    android:textStyle="bold"
                    android:backgroundTint="#FFFFFF"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp" android:insetBottom="0dp"/>

                <Button
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Categorías (8)"
                    android:textSize="11sp"
                    android:textColor="#7A6D63"
                    android:backgroundTint="@android:color/transparent"
                    android:elevation="0dp"
                    app:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp" android:insetBottom="0dp"/>
            </LinearLayout>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_input"
                android:hint="Buscar por producto, tienda o ID..."
                android:textColorHint="#A68A78"
                android:textColor="#3D3028"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="10dp"
                android:layout_marginBottom="16dp"
                app:tint="#7A6D63"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:scaleType="centerCrop"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:background="@drawable/bg_search_input"
                            android:layout_marginEnd="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sofá compacto Nórdico"
                                    android:textSize="14sp"
                                    android:textColor="#3D3028"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:text="Publicado"
                                    android:textSize="10sp"
                                    android:textColor="#5A6B5C"
                                    android:background="#EAF2EB"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="2dp"
                                    android:textStyle="bold"/>
                            </RelativeLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vendedor: Andrés Guzmán"
                                android:textSize="11sp"
                                android:textColor="#7A6D63"
                                android:layout_marginTop="2dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$899.000 COP"
                                android:textSize="13sp"
                                android:textColor="#C86D51"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EFECE6"
                        android:layout_marginBottom="10dp"
                        android:layerType="software"
                        android:backgroundTint="#D5CBC1"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">
                        <com.google.android.material.button.MaterialButton
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Revisar Ficha"
                            android:textSize="12sp"
                            android:textColor="#3D3028"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:strokeColor="#A68A78"
                            app:cornerRadius="8dp"
                            android:insetTop="0dp" android:insetBottom="0dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="Desactivar"
                            android:textSize="12sp"
                            android:textColor="#C86D51"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:strokeColor="#C86D51"
                            app:cornerRadius="8dp"
                            android:insetTop="0dp" android:insetBottom="0dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:scaleType="centerCrop"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:background="@drawable/bg_search_input"
                            android:layout_marginEnd="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Lámpara Luz Serena"
                                    android:textSize="14sp"
                                    android:textColor="#3D3028"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:text="Publicado"
                                    android:textSize="10sp"
                                    android:textColor="#5A6B5C"
                                    android:background="#EAF2EB"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="2dp"
                                    android:textStyle="bold"/>
                            </RelativeLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vendedor: Luminarias Serena Ltda."
                                android:textSize="11sp"
                                android:textColor="#7A6D63"
                                android:layout_marginTop="2dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$189.000 COP"
                                android:textSize="13sp"
                                android:textColor="#C86D51"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EFECE6"
                        android:layout_marginBottom="10dp"
                        android:backgroundTint="#D5CBC1"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">
                        <com.google.android.material.button.MaterialButton
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Revisar Ficha"
                            android:textSize="12sp"
                            android:textColor="#3D3028"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:strokeColor="#A68A78"
                            app:cornerRadius="8dp"
                            android:insetTop="0dp" android:insetBottom="0dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="Desactivar"
                            android:textSize="12sp"
                            android:textColor="#C86D51"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:strokeColor="#C86D51"
                            app:cornerRadius="8dp"
                            android:insetTop="0dp" android:insetBottom="0dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:scaleType="centerCrop"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:background="@drawable/bg_search_input"
                            android:layout_marginEnd="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Organizador vertical"
                                    android:textSize="14sp"
                                    android:textColor="#3D3028"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:text="Desactivado"
                                    android:textSize="10sp"
                                    android:textColor="#C86D51"
                                    android:background="#FDF3F0"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="2dp"
                                    android:textStyle="bold"/>
                            </RelativeLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vendedor: Muebles San José"
                                android:textSize="11sp"
                                android:textColor="#7A6D63"
                                android:layout_marginTop="2dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$349.000 COP"
                                android:textSize="13sp"
                                android:textColor="#C86D51"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EFECE6"
                        android:layout_marginBottom="10dp"
                        android:backgroundTint="#D5CBC1"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">
                        <com.google.android.material.button.MaterialButton
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Revisar Ficha"
                            android:textSize="12sp"
                            android:textColor="#3D3028"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:strokeColor="#A68A78"
                            app:cornerRadius="8dp"
                            android:insetTop="0dp" android:insetBottom="0dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="Reactivar"
                            android:textSize="12sp"
                            android:textColor="#5A6B5C"
                            app:backgroundTint="#EAF2EB"
                            app:elevation="0dp"
                            android:insetTop="0dp" android:insetBottom="0dp"
                            app:cornerRadius="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>