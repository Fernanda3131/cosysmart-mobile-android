<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FDFBF7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crea tu cuenta"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3D3028"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Un hogar en armonía empieza contigo."
            android:textSize="14sp"
            android:textColor="#7A6D63"
            android:layout_marginBottom="24dp"/>

        <!-- Nombre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#5C4D44"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#A68A78"
            app:startIconDrawable="@drawable/ic_person"
            app:startIconTint="#7A6D63">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tu nombre"
                android:inputType="textPersonName"
                android:textColor="#000000"
                android:textColorHint="#7A6D63"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Apellidos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apellidos"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#5C4D44"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#A68A78"
            app:startIconDrawable="@drawable/ic_person"
            app:startIconTint="#7A6D63">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApellidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tus apellidos"
                android:inputType="textPersonName"
                android:textColor="#000000"
                android:textColorHint="#7A6D63"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Correo electrónico -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#5C4D44"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#A68A78"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="#7A6D63">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="tu@correo.com"
                android:inputType="textEmailAddress"
                android:textColor="#000000"
                android:textColorHint="#7A6D63"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#5C4D44"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#A68A78"
            app:startIconDrawable="@android:drawable/ic_secure"
            app:startIconTint="#7A6D63"
            app:endIconMode="password_toggle"
            app:endIconTint="#7A6D63">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Crea una contraseña"
                android:inputType="textPassword"
                android:textColor="#000000"
                android:textColorHint="#7A6D63"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirmar contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirmar contraseña"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#5C4D44"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#A68A78"
            app:startIconDrawable="@android:drawable/ic_secure"
            app:startIconTint="#7A6D63"
            app:endIconMode="password_toggle"
            app:endIconTint="#7A6D63">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmarContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Repite tu contraseña"
                android:inputType="textPassword"
                android:textColor="#000000"
                android:textColorHint="#7A6D63"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usa al menos 8 caracteres, letras y números."
            android:textSize="11sp"
            android:textColor="#8C7C70"
            android:layout_marginBottom="16dp"/>

        <!-- ¿Cómo quieres unirte? -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Cómo quieres unirte?"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#5C4D44"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgTipoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="4dp">

            <RadioButton
                android:id="@+id/rbComprador"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="false"
                android:background="@drawable/radio_card_bg"
                android:buttonTint="#C86D51"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Registrarme como comprador"
                android:textColor="#3D3028"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"/>

            <RadioButton
                android:id="@+id/rbVendedor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:background="@drawable/radio_card_bg"
                android:buttonTint="#C86D51"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Solicitar ser vendedor"
                android:textColor="#3D3028"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ser vendedor requiere aprobación de tu solicitud."
            android:textSize="11sp"
            android:textColor="#8C7C70"
            android:layout_marginBottom="16dp"/>

        <!-- Términos y condiciones -->
        <CheckBox
            android:id="@+id/cbTerminos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acepto los Términos y condiciones y la Política de privacidad."
            android:textSize="12sp"
            android:textColor="#5C4D44"
            android:layout_marginBottom="24dp"/>

        <!-- Botón de Creación de cuenta -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegisterSubmit"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Crear cuenta"
            android:textSize="16sp"
            app:backgroundTint="#C86D51"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Iniciar sesión (ID actualizado a tvGoToLogin) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tienes una cuenta? "
                android:textSize="14sp"
                android:textColor="#7A6D63"/>

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar sesión"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#C86D51"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>