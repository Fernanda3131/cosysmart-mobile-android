<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CosySmart" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cosy_primary</item>
        <item name="colorPrimaryVariant">@color/cosy_dark_green</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="android:windowBackground">@color/cosy_bg</item>
    </style>
    <style name="Widget.CosySmart.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/cosy_primary</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.CosySmart.Button.Secondary" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/cosy_text_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/cosy_card_bg</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

</resources>