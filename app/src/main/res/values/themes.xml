<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CosySmart" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cosy_primary</item>
        <item name="colorPrimaryVariant">@color/cosy_dark_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/cosy_bg</item>
        <item name="android:fontFamily">serif</item>
        <item name="editTextStyle">@style/Widget.CosySmart.EditText</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cosy_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_clean</item>


        <item name="postSplashScreenTheme">@style/Theme.CosySmart</item>
    </style>
    <style name="Widget.CosySmart.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">#000000</item>
        <item name="android:textColorHint">#7A6D63</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="Widget.CosySmart.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/cosy_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="Widget.CosySmart.Button.Secondary" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/cosy_text_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/cosy_card_bg</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="Widget.CosySmart.RadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:textColor">@color/cosy_text_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:buttonTint">@color/cosy_primary</item>
        <item name="android:fontFamily">serif</item>
    </style>

</resources>